{
  "name": "autojob-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "gen:api": "python ../scripts/openapi.py > openapi.json && openapi-typescript openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0"
  }
}
